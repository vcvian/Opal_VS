<ol>

<!--standard code for all links-->
(set: _updateContent to [{
    <!--replace content-->
    (replace: ?bookContent)[(print: $stuff's currentCalendarBook)]
    <!--scroll up to page's top-->
    <script>window.scrollTo(0,0)</script>
}])


<li>(link-rerun: "Turn to the \"Days\" section")[{
    <!--set current content-->
    (set: $stuff's currentCalendarBook to _days)
    _updateContent
}]
<li>(link-rerun: "Turn to the \"Weeks\" section")[{
    <!--set current content-->
    (set: $stuff's currentCalendarBook to _weeks)
    _updateContent
}]
<li>(link-rerun: "Turn to the \"Months\" section")[{
    <!--set current content-->
    (set: $stuff's currentCalendarBook to _months)
    _updateContent
}]
<li>(link-rerun: "Read the foreword again.")[{
    <!--set current content-->
    (set: $stuff's currentCalendarBook to _foreword)
    <!--replace content-->
    _updateContent
}]
<li>(link-rerun: "Put the pamphlet away.")[{
    <!--clear $stuff-->
    (set: $stuff to (dm:))
    <!--goto-->
    (goto: $readingNav's before)
}]
<ol>



<!--content ends-->
    }],
)