:: Reading

(metadata:
    "title", "Reading",
)

<!--load full book DM-->
(set: _bookDM to (passage: "item." + (str: $readingNav's reading)))

$cssColumnParent[

$cssColumnChild[

    (css: "font-size: 70%")[
        <!--back link-->
        $cssColumnChild[(link: "⇦ Never mind.")[
            <!--clear $stuff, just in case the book uses it as a bookmark-->
            (set: $stuff to (dm:))
            <!--goto-->
            (goto: $readingNav's before)
        ]]
        $cssColumnChild[(link: "↺ Start over.")[
            <!--clear $stuff, just in case the book uses it as a bookmark-->
            (set: $stuff to (dm:))
            <!--refresh page-->
            (redirect: (passage:)'s name)
        ]]
    ]

	$cssBox[
    	($funcImage: _bookDM's img)
         $cssBoxItem[''Reading: //(print: _bookDM's id)//''
         <br>(print: _bookDM's desc)
         <br>$cssDesc[	↪	(print: _bookDM's tip)]
         (if: _bookDM's key contains "long")[<br>$cssDesc[	↪	⧗ This is a longer document. It may take an entire day or more to fully absorb it.]]]
    ]
]

$cssColumnChild[

(print: _bookDM's content)

]<!--child end-->
]<!--parent end-->