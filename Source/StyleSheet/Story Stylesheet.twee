:: Story Stylesheet [stylesheet]
tw-story {
  font-size: 1.0rem;
  align-items: center;
  color: #e1d7cf;
  background-color: #2e2721;
}

tw-passage {
  width: 80vw;
}

tw-dialog {
  width: 800px;
  min-width: 30%;
  max-width: 90%;
  color: #e1d7cf;
  background-color: #2e2721;
}

tw-dialog {
  animation: dissolve-in 0.2s ease-out;
}
@keyframes dissolve-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

tw-dialog-links {
  flex-wrap: wrap;
}

h1, h2, h3 {
 text-align: center;
}

li {
  margin-bottom: 0.9em;
}

tw-link, .enchantment-link {
  color: #2FA4D7;
}

hr {
  border: none; /* Removes the default border */
  height: 1px; /* Sets the line thickness */
  /* Ensures cross-browser compatibility with vendor prefixes */
  background: linear-gradient(to right, transparent, white, transparent); 
  background: -webkit-linear-gradient(to right, transparent, white, transparent); /* For older WebKit browsers */
  background: -moz-linear-gradient(to right, transparent, white, transparent); /* For older Firefox browsers */
  background: -o-linear-gradient(to right, transparent, white, transparent); /* For older Opera browsers */
  margin: 30px 0; /* Adds some spacing above and below */
}

.rainbow {
  background-image: linear-gradient(to right, violet, indigo, blue, green, yellow, orange, red, violet);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  animation: moveRainbowRight 5s linear infinite;
}

@keyframes moveRainbowRight {
  0% {
    background-position: 200% center;
  }
  100% {
    background-position: 0% center;
  }
}