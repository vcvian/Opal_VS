:: T: VehVeh Self [topic] {"position":"6275,1650","size":"100,100"}
{=

(storylet: when
(passage:) contains "NPC"
and $char's VehVeh's opinion's 2nd > 20
and $char's VehVeh's location is "Apesai Lighthouse"
and $char's player's timerCooldown does not contain "T: VehVeh Self"
)

(metadata:
"NPC", "VehVeh",
"title", "Regarding Veh-Veh Herself",
"topic", [{(cond:
		($funcTalkedTimesCheck: "nameVehVeh") < 1, "\"'Veh-Veh' - is that an Askavan name?\"",
		($funcTalkedTimesCheck: "nameVehVeh") < 2, "\"I still want to hear more about that name of yours - 'Veh-Veh'. It feels like there's more to that story.\"",
		"\"Apologies for asking again, but I am still curious about you, Veh-Veh.\"",
	)}],
"topicDetail", [{(cond:
	($funcTalkedTimesCheck: "nameVehVeh") < 1, "She seems like the chatty sort. Maybe she'll like talking about herself?",
	($funcTalkedTimesCheck: "nameVehVeh") < 2, "She's been cagey, but that only means that there's something worth hiding.",
	($funcTalkedTimesCheck: "nameVehVeh") < 3, "You are so close to cracking this case wide open.",
	"You should be double-wise and not bring this up again in a while.")}],
"cooldown", 1,
"talked", (a: "nameVehVeh", ),
"addCode", [{
	(if: ($funcTalkedTimesCheck: "nameVehVeh") >= 1)[{
    	($funcOpinionGainLoss: "VehVeh", -2, "Veh-Veh seems annoyed that you keep pursuing this line of questioning.")
    }]
}],
)

$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: VehVeh")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s topicDetail)]
    ]
]

$cssColumnChild[

$cssDesc[''You: //(print: (passage:)'s topic)//'']
<br>

<!--VehVehLine short hand-->
(set: _line to (hook: "VehVehLine"))

<!--First time intro-->
