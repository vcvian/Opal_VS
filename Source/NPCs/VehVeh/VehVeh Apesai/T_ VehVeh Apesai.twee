:: T: VehVeh Apesai [topic unfinished] {"position":"6750,1650","size":"100,100"}
{=

(storylet: when
(passage:) contains "NPC"
and $char's VehVeh's opinion's 2nd >= 10
and $char's VehVeh's location is "Apesai Lighthouse"
and $char's player's timerCooldown does not contain "T: VehVeh Apesai"
)

(metadata:
"NPC", "VehVeh",
"title", "Asking Veh-Veh About Apesai",
"topic", "\"I want to ask you something about this island-city.\"",
"topicDetail", "What's there to do, to see on this rock, how to get off of it, and so on.",
"cooldown", 1,
"talked", (a:),
"addCode", [],
"devNote", [Sub "convo." passages are still being written. Consider adding a reward mechanic (impressionApesai).]
)

$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: VehVeh")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s topicDetail)]
    ]
]

$cssColumnChild[

<!--VehVehLine short hand-->
(set: _line to (hook: "VehVehLine"))


$cssDesc[''You: //(print: (passage:)'s topic)//'']
<br>

<!--main content begins-->

_line["Erm... sure, I'm not the best tour guide - barely get out of the lighthouse - but I'll help however I can. What do you want to know?"]

<!--"spindle" convo, mode 2 (exit only after at least 1 turn)-->
<!--better idea to use the standard variable $stuff's convoChoices so that it can be reused at will in the content temp vars (I've removed automated spindle convo since conversations can go on a bit longer)-->
(set: $stuff's convoChoices to (dm:
     "<!--A-->\"Tell me about Apesai - generally.\"", "generalApesai",
     "<!--B-->\"Where is the local market? I'm in need of some supplies.\"", "marketApesai",
     "<!--C-->\"What is there to see, to //do// in Apesai?\"", "doApesai",
     "<!--D-->\"How does one leave the island?\"", "leaveApesai",
     "<!--E-->\"Actually, that's all for now.\"", "exitLink",
))

($funcSpindleConvo: $stuff's convoChoices, 2)

<!--first initialize, only then will the (display:) be of the right scope-->

<!--_generalApesai-->
(set: _generalApesai to (display: "convo.VehVeh.generalApesai"))


<!--_marketApesai-->
(set: _marketApesai to (display: "convo.VehVeh.marketApesai"))<!--end of _marketApesai-->


<!--_doApesai-->
(set: _doApesai to (display: "convo.VehVeh.doApesai"))<!--end of _doApesai-->


<!--_leaveApesai-->
(set: _leaveApesai to (display: "convo.VehVeh.leaveApesai"))<!--end of _leaveApesai-->


<!--_exitLink-->
(set: _exitLink to (display: "convo.VehVeh.exitLink"))<!--end of _exitLink-->


<!--main content ends-->

|done)[
<!--clear $stuff-->
(set: $stuff to (dm:))
<br>
---
<ol>
($funcNPCTopics: "Veh-Veh trails off. The mind can draw blanks when one is too familiar with the place.", "Thanks anyway, Veh-Veh. Bye.")
</ol>
]<!--end done-->

]<!--end child-->
]<!--end parent-->