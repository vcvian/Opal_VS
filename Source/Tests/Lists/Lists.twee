</ol><!--end of list menu-->
]<!--end of child-->

<!--display-->
$cssColumnChild[

<!--displayedList-->
[{
    (if: $stuff's currentList's length > 0)[{
<h3 id="displayedList">(print: $stuff's listTitle)</h3>
Count: ''[(print: $stuff's count)]<count|''        
<br>     
(box:"X", 23)+(bg: "#524538")[
<ol>(display: $stuff's currentList)</ol>
]

(rerun: ?count)
    }]<!--end of if able to display-->
    (else:)[$cssDesc[(Select a list to display.)]]
}]<displayedList|


]<!--end child-->
]<!--end parent-->