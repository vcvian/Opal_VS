:: Lists
{=

(metadata: "title", "Lists")

(link: "⇦ BACK")[(set: $stuff to (dm:))(goto: "Pre-Test (NEW)")]

$cssColumnParent[
<!--menu-->
$cssColumnChild[

<!--initialize-->
(if: $stuff does not contain "currentList")[(set: $stuff's currentList to "")]
(if: $stuff does not contain "listTitle")[(set: $stuff's listTitle to "")]
(set: $stuff's count to 0)

<!--display shorthand-->
(set: _displayCode to [{
    (t8n:"dissolve")
    (rerun: ?displayedList)
    <!--scroll up to page's top-->
    <script>document.getElementById("displayedList").scrollIntoView({ behavior: "smooth" });</script>
}])

<h3>Lists</h3>
Here we find lists of all things currently in the game.

<!--list menu-->
<ol>
''Item''
<br>
<li>(link-rerun: "All items")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "All Items")
    (set: $stuff's currentList to "list.itemAll")
    _displayCode
}]</li>

<li>(link-rerun: "Craftables")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Craftables")
    (set: $stuff's currentList to "list.itemCraftables")
    _displayCode
}]</li>

<li>(link-rerun: "Ingredients")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Ingredients")
    (set: $stuff's currentList to "list.itemIngredients")
    _displayCode
}]</li>

<li>(link-rerun: "Resource")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Resource")
    (set: $stuff's currentList to "list.itemResource")
    _displayCode
}]</li>

<li>(link-rerun: "Documents")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Documents")
    (set: $stuff's currentList to "list.itemDocs")
    _displayCode
}]</li>

<br>
''Att''
<br>
<li>(link-rerun: "All att")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "All Att")
    (set: $stuff's currentList to "list.attAll")
    _displayCode
}]</li>

<li>(link-rerun: "Elements")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Elements")
    (set: $stuff's currentList to "list.attElements")
    _displayCode
}]</li>

<li>(link-rerun: "Knowledge")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Knowledge")
    (set: $stuff's currentList to "list.attKnowledge")
    _displayCode
}]</li>

<li>(link-rerun: "Social")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Social")
    (set: $stuff's currentList to "list.attSocial")
    _displayCode
}]</li>

<li>(link-rerun: "Access")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Access")
    (set: $stuff's currentList to "list.attAccess")
    _displayCode
}]</li>

<li>(link-rerun: "Attributes")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Attributes")
    (set: $stuff's currentList to "list.attAttributes")
    _displayCode
}]</li>

<br>
''Temp''
<br>
<li>(link-rerun: "All temporaries")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "All Temporaries")
    (set: $stuff's currentList to "list.tempAll")
    _displayCode
}]</li>

<li>(link-rerun: "Memories")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Memories")
    (set: $stuff's currentList to "list.tempMemory")
    _displayCode
}]</li>

<li>(link-rerun: "Conditions")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Conditions")
    (set: $stuff's currentList to "list.tempConditions")
    _displayCode
}]</li>

<br>
''NPCs''
<br>
<li>(link-rerun: "All NPCs")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "All NPCs")
    (set: $stuff's currentList to "list.npcAll")
    _displayCode
}]</li>

<li>(link-rerun: "Notable NPCs")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Notable NPCs")
    (set: $stuff's currentList to "list.npcNotable")
    _displayCode
}]</li>

<li>(link-rerun: "Generic NPCs")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "Generic NPCs")
    (set: $stuff's currentList to "list.npcGeneric")
    _displayCode
}]</li>

<br>
''Quests''
<br>
<li>(link-rerun: "All quests")[{
    (set: $stuff's count to 0)
    (set: $stuff's listTitle to "All Quests")
    (set: $stuff's currentList to "list.questAll")
