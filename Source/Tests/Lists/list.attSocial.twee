:: list.attSocial
{=
(for: each _att, ...(passages: where its name contains "att."))[{
    (if: _att's key contains "social")[(set: $stuff's count to it + 1)
    <li>''(print: _att's id)'' ((print: _att's name)) ($funcLogTip: "att.", (trimmed: "att.", _att's name))
    <br>$cssDesc[Key: (print: _att's key)]
    <br>$cssDesc[Value: (print: _att's value)]
    </li>]
}]