:: story.babysitMarket.exciting.1
{=
(metadata:
"story", [{
    (sample exciting story 1)

    <!--set the done link text-->
    (set: _babysitMarketChoice1 to "exciting story 1 choice 1")
    (set: _babysitMarketChoice2 to "exciting story 1 choice 2")
    <!--should end with (show: ?done)-->
}],

"success", [{
    (sample exciting story 1 success)
    (set: _babysitMarketDoneLink to "exciting story 1 link text (success)")
}],

"fail", [{
    (sample exciting story 1 fail)
    (set: _babysitMarketDoneLink to "exciting story 1 link text (fail)")
}],
)



