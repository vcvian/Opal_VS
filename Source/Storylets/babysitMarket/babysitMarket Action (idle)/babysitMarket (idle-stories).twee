:: story.babysitMarket.idle.1
{=

(metadata:
"story", [{
    (sample idle story 1)

    <!--set the done link text-->
    (set: _babysitMarketChoice1 to "idle story 1 choice 1")
    (set: _babysitMarketChoice2 to "idle story 1 choice 2")
    <!--should end with (show: ?done)-->
}],

"success", [{
    (sample idle story 1 success)
    (set: _babysitMarketDoneLink to "idle story 1 link text (success)")
}],

"fail", [{
    (sample idle story 1 fail)
    (set: _babysitMarketDoneLink to "idle story 1 link text (fail)")
}],
)

