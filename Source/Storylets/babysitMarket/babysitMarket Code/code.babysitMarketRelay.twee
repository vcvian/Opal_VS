:: code.babysitMarketRelay [unfinished]
{=

(metadata:
"devNote", [Touch up on the prose of the various notifications.],

"endAction", [{
    <!--Are we near the end of the quest?-->
    (set: _nearQuestEnd to false)
    (if: ($funcCheckExists: $char's player's att, "babysitMarketReturn", 0) <= 0)[(set: _nearQuestEnd to true)]

    <!--When close to the end, roll to see if there will be a fatigue interrupt-->
    (set: _fatigueInterrupt to false)
    (if:
        _nearQuestEnd
        and ($funcCheckExists: $char's player's att, "babysitMarketFatigue", 0) > (random: 3,4)
    )[(set: _fatigueInterrupt to true)]

    <!--Has the player done well?-->
    (set: _didWell to false)
    (if: 
        _nearQuestEnd
        and ($funcCheckExists: $char's player's att, "babysitMarketEdValue", 0) > (random: 2,3)
    )[(set: _didWell to true)]

    <!--Finally, perform relay calculations:
    1. If not near the end, then return to action hub.
    2. If near the end, then compare the good and bad and roll dice:
        a. Sum of fatigue and edValue must be at least 1.
        b. Roll within the range of (1, sum)
        c. Fatigue is threshold; failing which will goto interrupt-bad. Else, goto interrupt-good
    -->


}],
)