:: code.babysitMarketRelay [unfinished]
{=

(metadata:
"devNote", [Touch up on the prose of the various notifications.],


"evaluateTrackers", [{
    <!--will output _evaluate to either "neutral", "good", or "bad"-->
    <!--initialize-->
    (set: _evaluate to "neutral")

    <!--is good?-->
    (if: ($funcCheckExists: $char's player's att, "babysitMarketEdValue", 0) > (random: 2,3))[(set: _evaluate to "good")]

    <!--is bad? (override)-->
    (if: ($funcCheckExists: $char's player's att, "babysitMarketFatigue", 0) > (random: 3,4))[(set: _evaluate to "bad")]
}],

"endAction", [{
    
    <!--initialize evaluation-->
    (set: _evaluate to "neutral")
    <!--run evaluation code, should turn _evaluate to either "neutral", "good", or "bad"-->
    (print: (passage: "code.babysitMarketRelay")'s evaluateTrackers)

    <!--are we close to the end?-->
    (set: _nearQuestEnd to false)
    (if: ($funcCheckExists: $char's player's att, "babysitMarketReturn", 0) <= 0)[(set: _nearQuestEnd to true)]

    <!--if bad, goto bad-->
    (if: _evaluate is "bad" and _nearQuestEnd)[{
        (goto: "babysitMarket (interrupt-bad)")
    }]

    <!--if good, goto good-->
    (if: _evaluate is "good" and _nearQuestEnd)[{
        (goto: "babysitMarket (interrupt-good)")
    }]

    <!--otherwise, neutral or not near the end, return to action hub-->
    (if: _evaluate is "neutral" or _nearQuestEnd is false)[{
        (goto: "babysitMarket (action)")
    }]
}],
)