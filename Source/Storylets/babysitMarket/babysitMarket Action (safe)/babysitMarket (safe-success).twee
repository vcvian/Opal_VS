:: babysitMarket (safe-success)
{=
(metadata:
"title", "safe success",
"cardDesc", "safe desc",
"devNote", [placeholder],
)

$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: babysitMarket (start)")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s cardDesc)]
    ]
]

$cssColumnChild[

<!--run voice formatting code-->
(display: "code.babysitMarketEnchantLine")
<!--initialize shorthands-->
(set: _line1 to (hook: "line1"))
(set: _line2 to (hook: "line2"))
(set: _line3 to (hook: "line3"))
(set: _line4 to (hook: "line4"))
(set: _line5 to (hook: "line5"))
(set: _line6 to (hook: "line6"))
<!--default end link text-->
(set: _babysitMarketDoneLink to "default end text")

<!--default reward values-->
(set: _gainEdValue to 1)
(set: _gainFatigue to 1)
<!--default reward-->
(set: _babysitMarketDoneReward to [{
     <!--gain EdValue-->
     ($funcGainLoss: "att.", "babysitMarketEdValue", _gainEdValue)
     <!--gain fatigue-->
     ($funcGainLoss: "att.", "babysitMarketFatigue", _gainFatigue)
}])

<!--main content-->
(print: (passage: $stuffDaily's babysitMarketStory)'s success)
<!--end of main content-->

<!--done-->
[
<br>
---
(link: _babysitMarketDoneLink)[{
     <!--reward-->
     _babysitMarketDoneReward
     <!--goto next-->
     (print: (passage: "code.babysitMarketRelay")'s endAction)

}]
]<done|

]<!--end child-->
]<!--end parent-->
