:: S: Currency Exchange (GE) [storylet unfinished]
{=

(storylet: when
$place's sublocation is "The Grand Exchange"
)
(urgency: .9)
(metadata:
    "title", "Apesai's Currency Swap Office",
    "cardDesc", "The Grand Exchange will sell you many things, on the condition that you only use the rial. This one office accepts every kind of coin, but the only thing it will sell are rials.",
    "img", "https://thefifthcity.wiki/w/images/3/3f/Currency3_copper.png",
    "currency", "rial",
    "parent", "S: Shopping Day 1",
    "devNote", [Write the prose. Everything else is practically done.],
)


<!--Market setup-->
<!--item list-->
(set: _itemList to (a:))
(for: each _itemDM, ...(passages: where its name contains "item."))[{
     (if: _itemDM's key contains "currency" and _itemDM's name does not contain "rial")[{
        (set: _itemList to it + (a: (trimmed: "item.", _itemDM's name)))
     }]
}]
<!--buy factor-->
(set: _buyFactors to (passage: "table.marketPriceMod")'s universalBuy)
<!--sell factor-->
(set: _sellFactors to ($funcMarketMergeFactors: _buyFactors, (passage: "table.marketPriceMod")'s universalSell))
<!--define base mods-->
(set: _baseBuyMod to 1.15)
(set: _baseSellMod to .8)
<!--end of market setup-->

$cssColumnParent[

$cssColumnChild[

	(css: "font-size: 70%")[
        $cssColumnChild[{(link: "⇦ Exit the Grand Exchange.")[$funcBack]}]
        $cssColumnChild[{(link: "⇦ Browse the shops.")[(goto: (passage:)'s parent)]}]
     ]

	$cssBox[
    	($funcImage: (passage: "S: Shopping Day 1")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s cardDesc)]
    ]
]

$cssColumnChild[
(prose)
]<!--end child-->
]<!--end parent-->

---

$cssColumnParent[
$cssColumnChild[
<!--Readout-->
$cssDesc[($funcMarketReadoutFull: _baseBuyMod, _baseSellMod, _itemList, _buyFactors, _sellFactors)]
<!--end of readout-->
]<!--end child, begin another-->

$cssColumnChild[
<!--main buy/sell menu-->
<ol>
($funcMarketMain: _baseBuyMod, _baseSellMod, (passage:)'s currency, _itemList, _buyFactors, _sellFactors, 3)
<br>
Or...
<br>
<li>(link: "Browse the shops.")[(goto: (passage:)'s parent)]</li>
<li>(link: "Exit the Grand Exchange.")[$funcBack]</li>
</ol>
<!--end of main buy/sell menu-->

]<!--end child-->
]<!--end parent 2-->