:: studentDebate 2Y {"position":"5650,1875","size":"100,100"}
{=

(metadata:
"title", "The Student Debate",
"cardDesc", "Helped out side Y.",
)

$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: studentDebate 2")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s cardDesc)]
    ]
]

$cssColumnChild[

<!--must initialize temp var-->
(set: _debateDaysLeft to 0)
<!--code.studentDebate outputs
_debateDaysLeft
_contributeX
_contributeY
_advantage
_victor
_whim
-->
(display: "code.studentDebate")

(if: _debateDaysLeft is 4)[Side Y, Topic A...]

(elseif: _debateDaysLeft is 3)[Side Y, Topic B...]

(elseif: _debateDaysLeft is 2)[Side Y, Topic C...]

(elseif: _debateDaysLeft is 1)[Side Y, Topic D...]

<br>
---
(set: _endDebateDayText to "")
(if: _debateDaysLeft <= 1)[(set: _endDebateDayText to "Thus, the debates conclude.")]
(else:)[(set: _endDebateDayText to "End the day with a thought about side Y.")]

(link: _endDebateDayText)[{
	($funcGainLoss: "att.", "studentDebateY", 1)
    (if: _debateDaysLeft <= 1)[(goto: "studentDebate 2 END")]
    <!--^ if last day, goes to a concluding passage instead of ending the day-->
    (dialog: [The debate will continue tomorrow. Do come back to the lighthouse for more.])
    $funcDone
}]

]<!--end child-->
]<!--end parent-->