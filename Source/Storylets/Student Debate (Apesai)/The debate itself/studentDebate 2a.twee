:: studentDebate 2a {"position":"5575,1750","size":"100,100"}
{=

(metadata:
"title", "The Debate",
"cardDesc", "",
)


$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: studentDebate 2")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s cardDesc)]
    ]
]

$cssColumnChild[


<!--must initialize temp var-->
(set: _debateDaysLeft to 0)
(set: _advantage to 0)
(set: _sideXText to "")
(set: _sideYText to "")
<!--code.studentDebate outputs
_debateDaysLeft
_contributeX
_contributeY
_advantage
_victor
_whim
-->
(display: "code.studentDebate")

(if: _debateDaysLeft is 4)[Topic A...
(set: _sideXText to "Side X's argument on topic A")
(set: _sideYText to "Side Y's argument on topic A")
]

(elseif: _debateDaysLeft is 3)[Topic B...
(set: _sideXText to "Side X's argument on topic B")
(set: _sideYText to "Side Y's argument on topic B")
]

(elseif: _debateDaysLeft is 2)[Topic C...
(set: _sideXText to "Side X's argument on topic C")
(set: _sideYText to "Side Y's argument on topic C")
]

(elseif: _debateDaysLeft is 1)[Topic D...
(set: _sideXText to "Side X's argument on topic D")
(set: _sideYText to "Side Y's argument on topic D")
]

<br>
(They notice you can call out to you to be their referee/tiebreaker (where are all the teachers?). Prompt to pick side...)
<br>
$cssDesc[{
	(if: _advantage > 0)[Side Y currently has the advantage.]
    (else:)[Side X currently has the advantage.]
}]
<br>
---
<ol>
<li>(link: _sideXText)[(goto: "studentDebate 2X")]
<li>(link: _sideYText)[(goto: "studentDebate 2Y")]
<li>(link: "Pick no side.")[(goto: "studentDebate none")]
</ol>

]<!--end child-->
]<!--end parent-->