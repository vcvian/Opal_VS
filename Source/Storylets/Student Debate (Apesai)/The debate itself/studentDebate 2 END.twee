:: studentDebate 2 END {"position":"5575,2000","size":"100,100"}
{=

(metadata:
"title", "The Student Debate",
"cardDesc", "",
)

$cssColumnParent[

$cssColumnChild[
	$cssBox[
    	($funcImage: (passage: "S: studentDebate 2")'s img)
         $cssBoxItem[''(print: (passage:)'s title )''<br>(print: (passage:)'s cardDesc)]
    ]
]

$cssColumnChild[
<!--must initialize temp var-->
(set: _victor to "")
(set: _contributeX to false)
(set: _contributeY to false)
(set: _whim to false)
(set: _resetDebate to [])
<!--code.studentDebate outputs
_debateDaysLeft
_contributeX
_contributeY
_advantage
_victor
_whim
-->
(display: "code.studentDebate")

<!--code.studentDebateReset outputs _resetDebate codeblock-->
(display: "code.studentDebateReset")


Announcement:
<br>

<!--Victor-->
(if: _victor is "Y")[
Side Y victory.
<br>
(if: _whim)[The judge made an arbitrary ruling. No fair!]
(else:)[All fair here.]
]<!--end of side Y victory-->

(else:)[Side X victory.
<br>
(if: _whim)[The judge made an arbitrary ruling. No fair!]
(else:)[All fair here.]
]<!--end of side X victory-->

<br>

<!--Contribution-->
(if: _victor is "X")[
	(if: _contributeX)[Side X thanks you, mention reward.]
	(elseif: _contributeY)[Side Y thanks you for helping out anyway, even though they didn't win.]
	(else:)[Neither side acknowledges you, since you didn't sufficiently help either of them.]
]

(if: _victor is "Y")[
	(if: _contributeY)[Side Y thanks you, promises reward.]
	(elseif: _contributeX)[Side X admonishes you for not trying harder.]
	(else:)[Neither side acknowledges you, since you didn't sufficiently help either of them.]
]



<br>
---

<!--Made a bet or not?-->
(set: _madeBet to false)
(if: (($funcCheckExists: $char's player's inv, "betTicketX", 0) > 0 or ($funcCheckExists: $char's player's inv, "betTicketY", 0) > 0))[(set: _madeBet to true)]

<!--_gotoNext depends on whether a bet was made-->
(set: _gotoNext to "mockDay")
(if: _madeBet)[(set: _gotoNext to "S: studentDebate (Bookie After)")]

<!--If Y victory-->
(if: _victor is "Y")[{
	($funcQuestUpdateLink: "Side Y Victory.", "studentDebate", "completed", "Yaay, you go Y! (But it'll restart)", "Side Y notification.", [{
		(if: _contributeY)[(dialog: [Side Y reward.])]
        (if: _madeBet is false)[_resetDebate]
	}], _gotoNext,)
}]<!--end if Y-->

<!--If X victory-->
(else:)[{
	($funcQuestUpdateLink: "Side X Victory.", "studentDebate", "completed", "Glory to side X! (But it'll restart)", "Side X notification.", [{
		(if: _contributeX)[(dialog: [Side X reward.])]
        (if: _madeBet is false)[_resetDebate]
	}], _gotoNext,)
}]<!--end if X-->

]<!--end child-->
]<!--end parent-->