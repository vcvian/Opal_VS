:: AA. Helper Macros [startup] {"position":"1350,3250","size":"100,100"}
{=

<!--Saves the current passage to return from UI menus-->
(set: $currentPassage to "The Pilgrim's Rest")

<!--global dice-->
(set: $dice to (random: 1,100))

<!--Workaround for storylets: Check exists, then output thing's data-->
(set: $funcCheckExists to (macro: any-type _pocket, str-type _thing, any-type _out,[\
	(if: _pocket contains _thing)[(set: _out to _pocket's _thing)]\
	(out-data: _out)\
]))

<!--translates number into Nurango words-->
(set: $funcNumToNurango to (macro: num-type _input, [{
	<!--initialize output var-->
	(set: _out to "")

	<!--initialize temp var-->
	(set: _hundreds to "")
	(set: _tens to "")
	(set: _singles to "")

	<!--define Nurango numbers-->
	(set: _dict to (dm:
	"0", "hun",
	"1", "yek",
	"2", "du",
	"3", "ser",
	"4", "char",
	"5", "pan",
	"6", "shes",
	"7", "haft",
	"8", "hasht",
	"9", "noh",
	"10", "dah",
	))

	<!--parse _input-->
	(set: _length to (str:_input)'s length)

	<!--switch cases-->
	<!--3 places-->
	(if: _length is 3)[{
		<!--hundreds-->
		(set: _hundreds to _dict's ((str: _input)'s 1st) + "sat")
		(if: (str: _input)'s 1st is "1")[(set: _hundreds to "sat")]
		<!--tens-->
		(set: _tens to _dict's ((str: _input)'s 2nd) + "dah")
		(if: (str: _input)'s 2nd is "1")[(set: _tens to "dah")]
		(if: (str: _input)'s 2nd is "0")[(set: _tens to "hun")]
		<!--singles-->
		(if: (str: _input)'s 3rd is not "0")[(set: _singles to _dict's ((str: _input)'s 3rd))]
		<!--collate hundreds and tens-->
		(set: _out to _hundreds+"-"+_tens)
		(if: (str: _input)'s 2nd is "0" and (str: _input)'s 3rd is "0")[(set: _out to _hundreds)]
		<!--collate singles, ONLY if singles isn't zero-->
		(if: (str: _input)'s 3rd is not "0")[(set: _out to it + "-"+_singles)]
	}]<!--3 places-->

	<!--2 places-->
	(elseif: _length is 2)[{
		<!--tens-->
		(set: _tens to _dict's ((str: _input)'s 1st) + "dah")
		(if: (str: _input)'s 1st is "1")[(set: _tens to "dah")]
		(if: (str: _input)'s 1st is "0")[(set: _tens to "hun")]
		<!--singles-->
		(if: (str: _input)'s 2nd is not "0")[(set: _singles to _dict's ((str: _input)'s 2nd))]
		<!--collate tens and singles-->
		(set: _out to _tens+"-"+_singles)
		<!--If singles is zero-->
		(if: (str: _input)'s 2nd is "0")[(set: _out to _tens)]
	}]<!--end of 2 places-->

	<!--1 place-->
	(elseif: _length is 1)[{
		<!--singles-->
		(set: _singles to _dict's ((str: _input)'s 1st))
		<!--collate?-->
		(set: _out to _singles)
	}]<!--end 1 place-->

	(else:)[(set: _out to [(color: red)[ERROR! `$funcNumToNurango` failed to translate a (str: _length)-digit number.]])]

	<!--output data-->
	(out-data: _out)
}]))

<!--"stuff" datamap to track miscellaneous things. Meant to be deleted-->
(set: $stuff to (dm:))

<!--daily version of $stuff, to be cleared at setDay/mockDay-->
(set: $stuffDaily to (dm:))