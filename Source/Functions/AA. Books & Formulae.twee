:: AA. Books & Formulae [startup]
{=
<!--Macros related to books and reading-->

(set: $readingNav to (dm:
    "before", "",
    "reading", "",
    "after", "",
))

<!--function will:
    1. Takes book name (w/o "item.") as argument.
    2. Creates link to book "content" page ("Reading" passage).
    3. Link saves the "before" (declare arguments).
    4. Automatically determines the "after" based on the DM's "long" key.
    4. Indicates if book will take whole day to read.
    -->
(set: $funcRead to (macro: str-type _bookName, str-type _before, [(out:)[{
    <!--Load full book DM-->
    (set: _bookDM to (passage: "item." + _bookName))
    (set: _bookID to (str: _bookDM's id))

    <!--long? Or can read in a day?-->
    (set: _long to false)
    (if: _bookDM's key contains "long")[(set: _long to true)]

    <!--Create link-->
    Read //(link-rerun: _bookID)[
        <!--Reload full book DM-->
        (set: _bookDM to (passage: "item." + _bookName))
    
        <!--saves to $readingNav-->
        (set: $readingNav's before to _before)
        (set: $readingNav's reading to _bookName)

        (if: _long)[(set: $readingNav's after to "mockDay")]
        (else:)[(set: $readingNav's after to _before)]

        <!--then goto-->
        (goto: "Reading")
    ]<!--end of link-->
    //<!--end of italicize book's name-->
    
    <!--long text warning-->
    (if: _long)[<br>$cssDesc[(⧗ Longer document: Takes a whole day or more to read.)]]

}]]))

<!--Build a reading list, then create reading links (via $funcRead)
Types of document:
1. book (for fun or to learn)
2. map (explains the setting)
3. legal (function as passes)
4. note (trackers in quests or letters)
-->
(set: $funcReadingList to (macro: array-type _list, [(out:)[{
    <!--initialize all sub-lists-->
    (set: _listBook to (a:))
    (set: _listMap to (a:))
    (set: _listLegal to (a:))
    (set: _listNote to (a:))

    <!--Loop through main list-->
    (for: each _bookName, ..._list)[
        <!--load book's full DM-->
        (set: _bookDM to (passage: "item." + _bookName))

        <!--check if document-->
        (set: _ifDocument to false)
        (if: _bookDM contains "key")[
            (if: _bookDM's key contains "document")[
                (set: _ifDocument to true)
            ]<!--if key contains document-->
        ]<!--end of if has key, end of check if document-->

        <!--if document, begin sorting into sub-lists-->
        (if: _ifDocument)[

            <!--add to _listBook-->
            (if: _bookDM's key contains "book")[
                (set: _listBook to it + (a: _bookName))
            ]<!--end of add to _listBook-->

            <!--add to _listMap-->
            (if: _bookDM's key contains "map")[
                (set: _listMap to it + (a: _bookName))
            ]<!--end of add to _listMap-->

            <!--add to _listLegal-->
            (if: _bookDM's key contains "legal")[
                (set: _listLegal to it + (a: _bookName))
            ]<!--end of add to _listLegal-->

            <!--add to _listNote-->
            (if: _bookDM's key contains "note")[
                (set: _listNote to it + (a: _bookName))
            ]<!--end of add to _listNote-->

        ]<!--end of building list (_ifDocument)-->
    ]<!--end of main loop-->

    <!--Create links-->
    
    <!--_listBook sub-list-->
    (if: _listBook's length > 0)[
        <details open>
        <summary>''Books:'' $cssDesc[From thin pamphlets to weighty times, from sappy slop to dry academicism, they all have something to teach.]</summary>
        <ol>
        <!--loop-->
        (for: each _nameBook, ..._listBook)[
            <li>($funcRead: _nameBook, (passage:)'s name)
        ]
        <!--end of loop-->
        </ol>
        </details>
    ]
    <!--end of _listBook sub-list-->

    <!--_listMap sub-list-->
    (if: _listMap's length > 0)[
        <details open>
        <summary>''Maps & Atlases:'' $cssDesc[It is said that nothing is real until someone has described it.]</summary>
        <ol>
        <!--loop-->
        (for: each _nameMap, ..._listMap)[
            <li>($funcRead: _nameMap, (passage:)'s name)
        ]
        <!--end of loop-->
        </ol>
        </details>
    ]
    <!--end of _listMap sub-list-->

    <!--_listLegal sub-list-->
    (if: _listLegal's length > 0)[
        <details open>
        <summary>''Legal Papers:'' $cssDesc[Identifications, permits, contracts, vouchsafes, and anything with an official-looking seal.]</summary>
        <ol>
        <!--loop-->
        (for: each _nameLegal, ..._listLegal)[
            <li>($funcRead: _nameLegal, (passage:)'s name)
        ]
        <!--end of loop-->
        </ol>
        </details>
    ]
    <!--end of _listLegal sub-list-->

    <!--_listNote sub-list-->
    (if: _listNote's length > 0)[
        <details open>
        <summary>''Notes & Letters:'' $cssDesc[To others, to self, to inform, to remind, and sometimes, to warn.]</summary>
        <ol>
        <!--loop-->
        (for: each _nameNote, ..._listNote)[
            <li>($funcRead: _nameNote, (passage:)'s name)
        ]
        <!--end of loop-->
        </ol>
        </details>
    ]
    <!--end of _listNote sub-list-->

    <!--No book-->
    (if: _listBook's length <= 0 and _listMap's length <= 0 and _listLegal's length <= 0 and _listNote's length <= 0)[''Empty:'' $cssDesc[You currently do not have anything to read. What kind of scholar //are// you?]]

    <!--end of link-creatiion-->
}]]))



(set: $funcLearnFormula to (macro: str-type _itemName, [(out:)[{
    <!--Load item's full DM-->
    (set: _itemDM to (passage: "item." + _itemName))

    <!--Check if formula is already known-->
    (set: _alreadyKnow to false)
    (if: $char's player's craftFormula contains _itemName)[(set: _alreadyKnow to true)]

    <!--if not known, then add, then notify-->
    (unless: _alreadyKnow)[
        <!--add-->
        (set: $char's player's craftFormula to it + (a: _itemName))
        
        <!--determine level readout-->
        (set: _level to "")
        (if: _itemDM's level is 1)[(set: _level to "simple")]
        (elseif: _itemDM's level is 2)[(set: _level to "complex")]
        (elseif: _itemDM's level is 3)[(set: _level to "exotic")]

        <!--Notify-->
        ($funcNoti: "arcane", [''<span class="rainbow">Learned new formula:</span>'' <br> You now know how to synthesize ''(print: _itemDM's id)''. <br> $cssDesc[(Have|need at least: ($funcElementHaveNeed: _itemName, 1) Requires a ''_level'' workstation or better.)] <br>
---
        <br> ''(print: _itemDM's id)'' <br> (print: _itemDM's desc) <br> $cssDesc[(print: _itemDM's tip)]], "✓")
        <!--end of notification-->

        <!--log-->
        (set: $log to it + (a: "''" + (str: (passage:)'s title) + "'': " + "<span class=\"rainbow\">Learned new formula</span>" + " for ''" + (str: _itemDM's id) + "'' ($funcLogTip: \"item.\",\"" + (str:_itemName) + "\"). Requires a ''" + (str: _level) + "'' workstation or better."))
        <!--end of log-->

    ]<!--end of already know + adding + notifying-->
}]]))