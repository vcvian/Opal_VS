:: Journal [UI] {"position":"2425,2500","size":"100,100"}
{=

(metadata:
    "UI", true,
)

($funcUITopBar:)


<!--initialize temp var-->
(set: _listStories to (a:))
(set: _displayStories to (a:))
(set: _keyList to (a:))
(set: _storiesTitle to "All Stories")
(set: _keyDesc to "Everything so far.")
(set: _displayMode to "active")
(set: _pointer to "everything")

<!--build a list of all visible (active, completed, failed) stories-->
(set: _listStories to (find: _story where $char's player's quests's _story is "active" or it is "completed" or it is "failed", ...(datanames: $char's player's quests)))

<!--Default: Display all stories (no filter)-->
(set: _displayStories to _listStories)

<!--parent 1: Menu-->
$cssColumnParent[
<!--Child 1a: info text-->
$cssColumnChild[

''Going-Ons''
<br>
The life of a journeyman is busy, so full of tasks to perform, promises to keep, and opportunities to grasp. The first thing to do is to remember at all.
<br>
$cssDesc[This screen shows ''on-going stories'' in which you are/were involved. You can also filter them by groupings of related stories and by stories' status.]

<br>

<!--check if making something-->
(set: _makingSomething to false)
(if: (data-names: $char's player's timerCraft)'s length > 0 and _displayMode is "active")[(set: _makingSomething to true)]

<!--generate "Making Something"-->
(if: _makingSomething is true)[{
    <!--create card-->
    $cssBox[
        <!--image-->
        ($funcImage: "https://thefifthcity.wiki/w/images/a/a2/Dawnmachinegaz.png")
        $cssBoxItem[
            (color:yellow+orange)[⧗]` `''Things Being Made'' — You have (plural: (datanames: $char's player's timerCraft)'s length, "on-going synthesis job")` `at the following locations:
            <!--scroll box-->$cssDesc+(css: "background: #615244;box-shadow: inset 0px 4px 8px rgba(0, 0, 0, 0.3);")+(box: "X", 5)[{
            <ol style="margin-block-start: 0; padding-left: 1em">
            (for: each _job, ...(datanames: $char's player's timerCraft))[{
                <!--note: Format is (dm: "lab", (a: "item", amount, timer)), where _job represents the lab's passage name-->
                
                <!--load lab DM-->
                (set: _labDM to (passage: _job))
                <!--load job info (array)-->
                (set: _jobInfo to $char's player's timerCraft's _job)
                <!--load item DM-->
                (set: _itemDM to (passage: "item." + _jobInfo's 1st))
                
                <!--print readout-->
                <li style=" line-height: 1.5">''(print: _labDM's title):''` `
                (print: _jobInfo's 2nd)` `
                (print: _itemDM's id)($funcLogTip: "item.", _jobInfo's 1st)` `
                <!--time-->
                (if: _jobInfo's 3rd > 0)[((plural: _jobInfo's 3rd, "day")` `left)]
                (else:)[(color: yellow+orange)[(Done!)]] 

                </li>

            }]<!--end of looping-->
            </ol>
            }]<!--end of scrollbox-->
        ]<!--end of boxItem-->
    ]<!--end of card/box-->
}]

]<!--end child 1a: info text-->


<!--Child 1b: menu-->
$cssColumnChild[

<!--default update code-->
(set: _updateCode to [{
	<!--update-->
	(t8n: "dissolve")(rerun: ?display)
	<!--scroll up to page's top-->
    <script>
	requestAnimationFrame(() => {
		document.getElementById("displayedList").scrollIntoView({
			behavior: "smooth",
			block: "start"
		});
	});
	</script>
}])

<!--filter links-->
''Story Groupings''
<ol style="column-count: 2;">

<li>(link-rerun: "All stories")[{
    <!--define list-->
    (set: _displayStories to _listStories)
    <!--set title-->
    (set: _storiesTitle to "All Stories")
    <!--set _keyDesc-->
    (set: _keyDesc to "Everything so far.")
    <!--set _pointer-->
    (set: _pointer to "everything")
    <!--reset _displayMode-->
    (set: _displayMode to "active")
    _updateCode
}]` `((print: _listStories's length))` `[(if: _pointer is "everything")+$cssDesc[↢ Current.]]<display|
</li>


<!--dynamically generate new filter links based on what story groupings I have-->
(display: "code.filterJournal")


</ol>
<br>
<!--end of filter links-->

<!--Display options-->
''Story Status''
<ol>

<li>(link-rerun: "Active stories")[{
    <!--set _displayMode-->
    (set: _displayMode to "active")
    <!--update-->
    _updateCode
}]` `[((print: (find: _story where $char's player's quests's _story is "active", ..._displayStories)'s length))` `$cssDesc+(if: _displayMode is "active")[↢ Current.]]<display|
</li>

<li>(link-rerun: "Completed stories")[{
    <!--set _displayMode-->
    (set: _displayMode to "completed")
    <!--update-->
    _updateCode
}]` `[((print: (find: _story where $char's player's quests's _story is "completed", ..._displayStories)'s length))` `$cssDesc+(if: _displayMode is "completed")[↢ Current.]]<display|
</li>

<li>(link-rerun: "Failed stories")[{
    <!--set _displayMode-->
    (set: _displayMode to "failed")
    <!--update-->
    _updateCode
}]` `[((print: (find: _story where $char's player's quests's _story is "failed", ..._displayStories)'s length))` `$cssDesc+(if: _displayMode is "failed")[↢ Current.]]<display|
</li>

</ol>

<!--end of display options-->

]<!--end child 1b: menu-->


]<!--end of parent 1: Menu-->

<br>
---
<br>

<!--main ?display hook-->
[

<!--code that filters _displayStories based on _displayMode (active, completed, or failed)-->
(set: _displayFiltered to (a:))
(for: each _story, ..._displayStories)[{
    (if: $char's player's quests's _story is _displayMode)[{
        (set: _displayFiltered to it + (a: _story))
    }]
}]

<!--determine mode icon-->
(set: _displayIcon to [(color: yellow+orange)[📜︎]])
(if: _displayMode is "active")[(set: _displayIcon to [(color: yellow+orange)[📜︎]])]
(if: _displayMode is "completed")[(set: _displayIcon to [(color: green)[✓]])]
(if: _displayMode is "failed")[(set: _displayIcon to [(color: red)[✗]])]

<!--macro that generates 2 left-right lists-->
(set: _listLeft to (a:))
(set: _listRight to (a:))
(set: _funcLeftRight to (macro: array-type _listAny, [(out:)[{
    
    <!--reset lists-->
    (set: _listLeft to (a:))
    (set: _listRight to (a:))

    (if: _listAny's length is > 0)[(for: each _i, ...(range: 1, _listAny's length))[{
        (if: _i % 2 is 1)[(set: _listLeft to it + (a: _listAny's _i))]
	    (else:)[(set: _listRight to it + (a: _listAny's _i))]
    }]]

}]]))

<!--macro that generates cards-->
(set: _funcStoryCard to (macro: array-type _listAny, codehook-type _indicator, [(out:)[{
    (if: _listAny's length > 0)[{
    <!--loop through input list-->
    (for: each _story, ..._listAny)[{
        <!--Load quest DM-->
        (set: _storyDM to (passage: "quest."+_story))
    
        <!--create card-->
        $cssBox[
            <!--image-->
            ($funcImage: _storyDM's img)
            $cssBoxItem[
                _indicator` `''(print: _storyDM's id)'' — (print:_storyDM's desc)\
                $cssDesc[<br>		↪  (print: _storyDM's tip)]\
                (if: (datanames: $char's player's timerQuest) contains _story)[
                    (for: each _timer, ...(datanames: $char's player's timerQuest's _story))[
                        $cssDesc[<br>		↪  (print: _storyDM's (_timer + "Desc"))]
                    ]<!--end of timer loops-->
                ]<!--end of if has timer-->
            ]<!--end of boxItem-->
        ]<!--end of box-->
    }]<!--end looping-->
    }]<!--end of if length > 0-->
}]]))


<!--actual content begins-->

<!--heading (active)-->
<h3 id="displayedList">_storiesTitle` `((upperfirst: _displayMode))</h3>
(align: "=><=")+$cssDesc+(css: "line-height: 1.2rem")[_keyDesc
<br>
''(plural: _displayStories's length, "story", "stories")''` `
((color: yellow+orange)[(print: (find: _story where $char's player's quests's _story is "active", ..._displayStories)'s length)]` `(if: _displayMode is "active")+(text-style: "wavy-underline")[''active''](else:)[active],
(color:green)[(print: (find: _story where $char's player's quests's _story is "completed", ..._displayStories)'s length)]` `(if: _displayMode is "completed")+(text-style: "wavy-underline")[''completed''](else:)[completed],
(color:red)[(print: (find: _story where $char's player's quests's _story is "failed", ..._displayStories)'s length)]` `(if: _displayMode is "failed")+(text-style: "wavy-underline")[''failed''](else:)[failed])
]
<br>
<!--parent 2: Display Cards-->
$cssColumnParent[

<!--build 2 lists (_listLeft, _listRight, which ought to be initialized already)-->
(_funcLeftRight: _displayFiltered)

<!--empty?-->
(set: _displayEmpty to true)
(if: _displayFiltered's length > 0)[(set: _displayEmpty to false)]

<!--Child 2a: left column-->
$cssColumnChild[

(if: _displayEmpty is false)[{

<!--generate story cards-->
(_funcStoryCard: _listLeft, _displayIcon)

}]
(else:)[$cssDesc[(Empty.)]]

]<!--end child 2a: left column-->


<!--Child 2b: right column-->
$cssColumnChild[

(_funcStoryCard: _listRight, _displayIcon)

]<!--end child 2b: right column-->


]<!--end of parent 2: Display Cards-->


]<display|
<!--end of main ?display hook that gets updated by filter-->