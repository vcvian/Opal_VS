:: People [UI unfinished] {"position":"2475,2550","size":"100,100"}
{=

(metadata:
    "UI", true,
    "devNote", [Make people keys dynamic so you don't have to manually add more in as you make more npcs and keys.],
)

($funcUITopBar:)

<br>

<!--initialize temp vars-->
(set: _peopleTitle to "People Met")
(set: _keyDesc to "All notable people you have met on your journey.")
(set: _pointer to "everyone")
(set: _peopleList to (a:))


<!--build full list, including unknown people-->
(set: _listFull to (find: _person where _person is not "player", ...(datanames: $char)))

<!--build list of all currently known people-->
(set: _listMet to (find: _person where $char's _person's know is true, ..._listFull))

<!--run default list (all met)-->
(set: _peopleList to _listMet)

<!--main UI begins-->

<!--menu-->
$cssColumnParent[
<!--info text-->
$cssColumnChild[

''People''
<br>
No magi succeed alone. On your journey, you will come to know many - from masters whom you might learn from, to foes who dog your steps, to simply fair-weather friends. You should do well to remember them.
<br>
$cssDesc[This screen shows ''people'' that you have met so far. You can also filter them by category, which are added as you get acquainted with more people.]

]<!--end of child-->
<!--end of info text-->

<!--Menu links-->
$cssColumnChild[

<!--default update code-->
(set: _updateCode to [{
	<!--update-->
	(t8n: "dissolve")(rerun: ?display)
	<!--scroll up to page's top-->
    <script>
	requestAnimationFrame(() => {
		document.getElementById("displayedList").scrollIntoView({
			behavior: "smooth",
			block: "start"
		});
	});
	</script>
}])

''Categories''

<ol style="column-count: 2;">

<li>(link-rerun: "Everyone")[{
	<!--filter _peopleList-->
	(set: _peopleList to _listMet)
	<!--set title-->
	(set: _peopleTitle to "Everyone Met")
	<!--set _keyDesc-->
	(set: _keyDesc to "All notable people you have met on your journey.")
	<!--set pointer-->
    (set: _pointer to "everyone")
	<!--update-->
	_updateCode
}]` `((print: _listMet's length))` `[(if: _pointer is "everyone")+$cssDesc[↢ Current.]]<display|
    </li></li>

<li>(link-rerun: "Everyone in the game (TEST)")[{
	<!--filter _peopleList-->
	(set: _peopleList to _listFull)
	<!--set title-->
	(set: _peopleTitle to "Everyone")
	<!--set _keyDesc-->
	(set: _keyDesc to "All characters, known or not.")
	<!--update-->
	_updateCode
}]</li>

<!--dynamically generate links based on how many categories of people met-->
(display: "code.filterPeople")

</ol>

]<!--end of child-->
]<!--end parent 1-->
<!--end of menu-->

<br>
---
<br>
<!--?display hook; refreshed when a menu filter is selected-->
[
<!--heading-->
<h3 id="displayedList">_peopleTitle</h3>
(align: "=><=")+$cssDesc+(css: "line-height: 1.2rem")[_keyDesc
<br>
''(plural: _peopleList's length, "person", "people")''
]

<!--display-->
$cssColumnParent[

<!--Code that generates cards-->
(set: _cardCode to (macro: array-type _list, [(out:)[{
	<!--only run if _smallList has any item at all-->
	(if: _list's length > 0)[
		(for: each _person where _person is not "player", ..._list)[{
			<!--load NPC's full DM-->
			(set: _personDM to (passage: "npc." + _person))

			<!--display their card-->
			$cssBox[
				<!--image-->
				($funcImage: _personDM's img)
				<!--text-->
				$cssBoxItem[
					''(print: _personDM's id)'' — (print: _personDM's desc)
					<br>$cssDesc[	↪	Opinion of you: (print: $char's _person's opinion's 1st) ''(($funcOpinionCalc: _person, true))'' ]
				]<!--end of text-->
			]<!--end of card-->
		}]<!--end of looping-->
	]<!--end of if _smallList has any item at all-->
}]]))

<!--Code that distributes _peopleList into different _smallLists-->
(set: _listLeft to (a:))
(set: _listRight to (a:))
(for: each _i, ...(range: 1, _peopleList's length))[{
	(if: _i % 2 is 1)[(set: _listLeft to it + (a: _peopleList's _i))]
	(else:)[(set: _listRight to it + (a: _peopleList's _i))]
}]


<!--left child-->
$cssColumnChild[
	(_cardCode: _listLeft)
]<!--end of left child-->


<!--right child-->
$cssColumnChild[
	(_cardCode: _listRight)
]<!--end of right child-->

]<!--end of parent 2-->
]<display|
<!--main UI ends-->