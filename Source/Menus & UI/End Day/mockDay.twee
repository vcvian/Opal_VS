(metadata: "title", "Passage of Time")

<!--Note to self: Why "mock"? It was supposed to be "setDay", but then I was testing out new codes in a new passage called "mockDay". Long story short, I now use only "mockDay" and has deleted the other passage.-->


<!--Change the weather-->
($funcWeatherToday:)

<!--Tick down jobs-->
($funcJobTickDown:)
<!--Tick down quest timer-->
($funcTimerQuestTickDown:)
<!--Tick down storylet timer-->
($funcStoryletCooldownTickdown:)
<!--Tick down temporary conditions-->
($funcTempTickDown:)

<!--Update NPC basic (health, opinion, energy)-->
($funcUpdateNPC:)
<!--Advance NPC travel along their set itinerary-->
($funcAdvanceNPCTravel:)
<!--Check & update NPC arc-->
($funcUpdateNPCArc:)

<!--Pay rent (place last)-->
($funcPayRent:)

<!--Advance 1 day-->
(display: "code.advanceDay")

<!--Tick down all current events-->
($funcEventTickdown:)
<!--Listen/auto-switch events (must come AFTER day's advance)-->
($funcEventListen:)
    
<!--Roll global dice-->
(set: $dice to (random: 1,100))

<!--clear out the $stuff family of variables-->
(set: $stuff to (dm:))
(set: $stuffDaily to (dm:))

<!--redirect-->
(goto: "nextDay")